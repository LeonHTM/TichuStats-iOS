    "export.description.profileData" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TichuStats sichert eine JSON-Datei in der Dateien App. Der Export kann länger dauern, wenn du schlechten Empfang hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το TichuStats θα σου επιτρέψει να αποθηκεύσεις ένα αρχείο JSON που περιέχει όλα τα δεδομένα που επέλεξες. Η εξαγωγή μπορεί να διαρκέσει περισσότερο αν έχεις κακή σύνδεση δικτύου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TichuStats will let you save a JSON file that contains all the data you selected. The export can take longer if you have a bad network connection."
          }
        }
      }
    },
    "export.description.statistics" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der gesamte Verlauf deiner Statistiken enthält jede einzelne Änderung deiner Statistiken, also sehr viel Daten. Sonst enthält das exportierte Dokument nur deine neusten Statistiken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το πλήρες ιστορικό των Στατιστικών περιλαμβάνει κάθε αλλαγή στα Στατιστικά σου, κάτι που είναι πολλά δεδομένα. Διαφορετικά, περιλαμβάνεται μόνο η πιο πρόσφατη τιμή για κάθε στατιστικό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The full history of Statistics includes every change in your Statistics, which is a lot of data. Otherwise it is just the most recent value for each statistic."
          }
        }
      }
    },
