    "round.notCounted" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Runde wird nicht gezählt. Dies, weil das Spiel so bearbeitet wurde, sodass nach %2$@ Runden %3$@ das Ziel %4$@ schon erreicht hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ γύρος δεν μετράει. Αυτό συμβαίνει επειδή το παιχνίδι επεξεργάστηκε έτσι ώστε να έχει ήδη τελειώσει μετά τον γύρο %2$@, επειδή ο/η %3$@ έφτασε το %4$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ round is not being counted. This happens because the game was edited, such that it already ended after round %2$@ because %3$@ reached %4$@."
          }
        }
      }
    },
