    "statistics.statscontainer.description.announcer.long" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie oft du (nicht unbedingt erfolgreich) ein Tichu, Grand Tichu oder besoffenen Pingu ansagst pro Runde.\n(Höher ist besser)"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πόσο συχνά δηλώνεις (όχι απαραίτητα με επιτυχία) Tichu, Big Tichu ή μεθυσμένο Pingu, κατά μέσο όρο ανά γύρο.\n(Όσο υψηλότερο, τόσο καλύτερο)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How often you announce (not necessarily successful) a Tichu, Big Tichu or drunken Pingu averaged per round.\n(Higher is better)"
          }
        }
      }
    },
    "statistics.statscontainer.description.bigGambler" : {
