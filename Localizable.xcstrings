    "statistics.statscontainer.description.rating.long" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Elo-Wertung wird neu berechnet nach jedem gewertetem Spiel. (Spiele mit Gästen sind nicht gewertet). Die Wertung erhöht sich bei einem Sieg und nimmt ab, falls du verlierst.\n(Höher ist besser)"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η βαθμολογία Elo σου ενημερώνεται μετά από κάθε βαθμολογημένο παιχνίδι (εξαιρούνται τα παιχνίδια με επισκέπτες), αυξάνεται όταν κερδίζεις και μειώνεται όταν χάνεις.\n(Όσο υψηλότερη, τόσο καλύτερη)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Elo rating updates after every rated game (excluding games with guests), increasing when you win and decreasing when you lose.\n(Higher is better)"
          }
        }
      }
    },
    "statistics.statscontainer.description.saboteur" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rate vorgebeugter Tichus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ποσοστό αποτροπής Tichu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevented tichus ratio."
          }
        }
      }
    },
    "statistics.statscontainer.description.saboteur.long" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Statistik beschreibt, wenn deine Gegner ein Tichu, Grand Tichu oder besoffener Pingu angesagt haben, wie oft du erst wirst und somit ihre Ansage zerstörst.\n(Höher ist besser)"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν οι αντίπαλοί σου δηλώνουν Tichu, Big Tichu ή μεθυσμένο Pingu, δείχνει πόσο συχνά τερματίζεις πρώτος και χαλάς τη δήλωσή τους, κατά μέσο όρο ανά γύρο.\n(Όσο υψηλότερο, τόσο καλύτερο)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When your opponents announce a Tichu, Big Tichu, or Drunken Pingu, this tracks how often you finish first and sabotage their announcement averaged per round.\n(Higher is better)"
          }
        }
      }
    },
    "statistics.statscontainer.description.teamplayer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
